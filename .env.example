# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Required for both /new-project forms (project inquiry, discovery call) to
# actually save anything. Create a project at https://neon.tech, then run
# db/schema.sql against it (Neon's SQL Editor, or `psql "$DATABASE_URL" -f
# db/schema.sql`) to create the tables. Get the connection string from the
# Neon dashboard's "Connect" button — use the pooled connection string.
# Without this set, both forms still render and validate, but submissions
# fail with a friendly "please email us directly" message instead of saving.
DATABASE_URL=

# Optional — sends the customer a confirmation email (to the address they
# typed in the form) on top of the database row whenever either form is
# submitted. Sign up at https://resend.com, create an API key, and paste it
# here. Without this set, submissions still save to the database; the
# customer just won't get a confirmation email.
RESEND_API_KEY=

# Used as the confirmation email's reply-to address (not its recipient — that's
# always the customer), so replies land in the studio's inbox. Defaults to
# info@karunatech.ca if unset.
CONTACT_TO_EMAIL=info@karunatech.ca

# Where you (the site owner) get notified of new submissions. Required for
# owner notifications to send — without it, only the customer's confirmation
# email goes out (if RESEND_API_KEY is set) and submissions still save either way.
OWNER_EMAIL=

# The "from" address Resend sends as. Defaults to Resend's shared test sender
# (onboarding@resend.dev), which works without setup but only delivers to the
# Resend account's own inbox. For real production delivery, verify a domain
# in Resend and point this at an address on it, e.g.:
# CONTACT_FROM_EMAIL="Karuna Technologies <hello@contact.karunatech.ca>"
CONTACT_FROM_EMAIL=
