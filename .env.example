# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Required for the /new-project inquiry form to actually send email.
# Sign up at https://resend.com, create an API key, and paste it here.
# Without this set, the form still renders and validates, but submissions
# fail with a friendly "please email us directly" message instead of sending.
RESEND_API_KEY=

# Where inquiry emails are delivered. Defaults to info@karunatech.ca if unset.
CONTACT_TO_EMAIL=info@karunatech.ca

# The "from" address Resend sends as. Defaults to Resend's shared test sender
# (onboarding@resend.dev), which works without setup but only delivers to the
# Resend account's own inbox. For real production delivery, verify a domain
# in Resend and point this at an address on it, e.g.:
# CONTACT_FROM_EMAIL="Karuna Technologies <hello@karunatech.ca>"
CONTACT_FROM_EMAIL=
